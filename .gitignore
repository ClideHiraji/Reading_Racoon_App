# --- Secrets (never commit) ---
.env
.env.*
!.env.example
*.keystore
*.jks
*.p12
*.pem
google-services.json

# --- Build outputs and IDE files ---
# The old Unity folder patterns ([Ll]ibrary/, [Tt]emp/, [Bb]uild/, [Ll]ogs/...)
# were removed: they matched at any depth and hid reading-racoon/scenes/library/.
*.csproj
*.unityproj
*.sln
*.suo
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db
*.pidb.meta
*.pdb.meta
*.mdb.meta
sysinfo.txt
crashlytics-build.properties
*.apk
*.aab
*.ipa
.vs/

# --- Godot 4 ---
.godot/
reading-racoon/android/build/
*.translation

# --- Laravel / PHP / Node ---
vendor/
node_modules/
/public/hot
/public/storage
storage/*.key
storage/logs/
storage/framework/cache/
storage/framework/sessions/
storage/framework/views/
.phpunit.result.cache
npm-debug.log
yarn-error.log

# --- Obsidian (personal workspace state) ---
**/.obsidian/workspace*.json
**/.obsidian/cache

# --- Editors / OS ---
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db
desktop.ini
