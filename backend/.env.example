APP_NAME="Reading Racoon"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# PostgreSQL 16+ only (D-001). Tests use DB_DATABASE=reading_racoon_test (phpunit.xml).
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=reading_racoon
DB_USERNAME=reading_racoon
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Version of the bundled game content; the client re-downloads when it changes (FR-11, FR-19).
CONTENT_VERSION=1

# The game offers the post-test (FR-10) only while this is true (GET /api/config).
POST_TEST_OPEN=false

# School time zone for play windows and daily limits (FR-12).
SCHOOL_TIMEZONE=Asia/Manila

# --- Hidden admin portal (D-013) ---
# Secret URL prefix, at least 32 letters/digits/-/_. Leave empty to turn the portal off.
# Generate your own: php -r "echo bin2hex(random_bytes(24)), PHP_EOL;"
# Never commit a real value or write it in docs, chats or issues.
ADMIN_PATH=
# Optional comma-separated IPs or CIDR ranges allowed to reach the portal, e.g. 203.0.113.7,10.0.0.0/24
ADMIN_ALLOWED_IPS=
ADMIN_IDLE_MINUTES=30

# --- Gemini through its OpenAI-compatible endpoint (later slice, docs/knowledge/08-ai-integration.md) ---
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_API_KEY=
LLM_MODEL=
