# Reading Racoon: production settings for the internet-facing home server (D-036).
# Copy to backend/.env on the server, fill the blanks, then run:
#   php artisan key:generate        (first install only; back the key up, see below)
#   php artisan migrate --force
#   php artisan config:cache && php artisan route:cache && php artisan view:cache
#   php artisan app:preflight       (every line must be PASS or an understood WARN)
# Full guide: docs/deploy/home-server.md. Never commit the filled-in file.

APP_NAME="Reading Racoon"
APP_ENV=production
# Losing APP_KEY logs every teacher out, breaks admin two-factor and, unless
# LOGIN_CODE_KEY is set, every child's login code. Keep a copy in a password manager.
APP_KEY=
APP_DEBUG=false
# The public https address of the tunnel, e.g. https://racoon.example.org (no trailing slash).
APP_URL=https://

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# One file per day, two weeks kept, so the laptop's disk can't fill up.
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DAILY_DAYS=14
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# PostgreSQL listens on 127.0.0.1 only; the app's role owns its database and nothing else.
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=reading_racoon
DB_USERNAME=reading_racoon
DB_PASSWORD=
DB_STATEMENT_TIMEOUT_MS=30000
DB_LOCK_TIMEOUT_MS=10000
DB_IDLE_IN_TRANSACTION_TIMEOUT_MS=60000
DB_CONNECT_TIMEOUT=5

# Teacher and admin sessions: https-only, encrypted, gone after 2 idle hours.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Needs the queue worker running (docs/deploy/home-server.md, "Services").
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@example.org"
MAIL_FROM_NAME="${APP_NAME}"

# Only the tunnel connector on this laptop may say who the client is. Never "*".
TRUSTED_PROXIES=127.0.0.1,::1
CORS_ALLOWED_ORIGINS=
HSTS_SECONDS=15552000
# Optional separate secret for login-code hashes (64 random hex chars); empty = from APP_KEY.
LOGIN_CODE_KEY=
SANCTUM_EXPIRATION_MINUTES=525600
SANCTUM_TOKEN_PREFIX=rr_

SYNC_REPLAY_DELAY_SECONDS=5
SYSTEM_LOG_INFO_DAYS=90
SYSTEM_LOG_ANOMALY_DAYS=365

# Nightly backup at 02:30 (php artisan app:backup). Put BACKUP_COPY_TO on another
# disk or a synced cloud folder (Google Drive for desktop, OneDrive) so a stolen
# or dead laptop doesn't take the backups with it. Windows paths go in SINGLE
# quotes: inside double quotes .env reads a backslash as an escape and fails.
BACKUP_PATH=
BACKUP_COPY_TO=
BACKUP_KEEP=14
BACKUP_PG_DUMP='C:\Program Files\PostgreSQL\18\bin\pg_dump.exe'
BACKUP_PG_RESTORE='C:\Program Files\PostgreSQL\18\bin\pg_restore.exe'

CONTENT_VERSION=1
POST_TEST_OPEN=false
SCHOOL_TIMEZONE=Asia/Manila
# Cloudflare's free plan accepts uploads up to 100 MB; keep videos well below it.
CONTENT_MAX_VIDEO_MB=50

# Hidden admin portal (D-013). Generate: php -r "echo bin2hex(random_bytes(24)), PHP_EOL;"
ADMIN_PATH=
# With the tunnel, these are real client IPs (TRUSTED_PROXIES). e.g. your home and school addresses.
ADMIN_ALLOWED_IPS=
ADMIN_IDLE_MINUTES=30

# Gemini teacher report (D-018). Off until all three are set.
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_API_KEY=
LLM_MODEL=
LLM_REASONING_EFFORT=
LLM_REPORT_MAX_TOKENS=600
LLM_REPORT_DELAY_MINUTES=10
