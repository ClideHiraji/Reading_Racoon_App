[gd_scene format=3]

[ext_resource type="Script" path="res://scenes/login/login.gd" id="1_login"]
[ext_resource type="Shader" path="res://ui/paper.gdshader" id="2_paper"]
[ext_resource type="Script" path="res://ui/chunky_button.gd" id="3_chunky"]
[ext_resource type="Script" path="res://scenes/companion/raccoon.gd" id="4_raccoon"]
[ext_resource type="Script" path="res://scenes/companion/speech_bubble.gd" id="5_bubble"]

[sub_resource type="ShaderMaterial" id="Paper"]
shader = ExtResource("2_paper")

[node name="Login" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_login")

[node name="Bg" type="ColorRect" parent="."]
material = SubResource("Paper")
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2

[node name="Margin" type="MarginContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/margin_left = 24
theme_override_constants/margin_top = 34
theme_override_constants/margin_right = 24
theme_override_constants/margin_bottom = 26

[node name="VBox" type="VBoxContainer" parent="Margin"]
layout_mode = 2
theme_override_constants/separation = 18

[node name="Top" type="HBoxContainer" parent="Margin/VBox"]
layout_mode = 2
theme_override_constants/separation = 12

[node name="Raccoon" type="Control" parent="Margin/VBox/Top"]
unique_name_in_owner = true
custom_minimum_size = Vector2(170, 170)
layout_mode = 2
script = ExtResource("4_raccoon")

[node name="Bubble" type="PanelContainer" parent="Margin/VBox/Top"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 4
script = ExtResource("5_bubble")

[node name="CodeRow" type="HBoxContainer" parent="Margin/VBox"]
unique_name_in_owner = true
layout_mode = 2
theme_override_constants/separation = 8
alignment = 1

[node name="Error" type="Label" parent="Margin/VBox"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 40)
layout_mode = 2
theme_override_colors/font_color = Color(0.741, 0.384, 0.071, 1)
theme_override_font_sizes/font_size = 26
horizontal_alignment = 1
autowrap_mode = 3

[node name="Keys" type="GridContainer" parent="Margin/VBox"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 4
theme_override_constants/h_separation = 12
theme_override_constants/v_separation = 12
columns = 6

[node name="Spacer" type="Control" parent="Margin/VBox"]
layout_mode = 2
size_flags_vertical = 3

[node name="GoButton" type="Button" parent="Margin/VBox"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 120)
layout_mode = 2
theme_override_font_sizes/font_size = 42
text = "LET'S GO!"
script = ExtResource("3_chunky")
face_color = Color(0.914, 0.502, 0.122, 1)
lift = 9
radius = 30

[node name="SkipButton" type="Button" parent="Margin/VBox"]
unique_name_in_owner = true
layout_mode = 2
theme_override_colors/font_color = Color(0.49, 0.408, 0.341, 0.8)
theme_override_font_sizes/font_size = 22
text = "Play without signing in (debug builds only)"
flat = true
