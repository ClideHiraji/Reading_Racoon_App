[gd_scene format=3]

[ext_resource type="Script" path="res://scenes/main.gd" id="1_main"]
[ext_resource type="Script" path="res://ui/chunky_button.gd" id="2_chunky"]
[ext_resource type="Script" path="res://scenes/companion/raccoon.gd" id="3_raccoon"]
[ext_resource type="Script" path="res://scenes/companion/speech_bubble.gd" id="4_bubble"]

[node name="Main" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_main")

[node name="Bg" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
color = Color(1, 0.9647, 0.8784, 1)

[node name="Hill" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 12
anchor_top = 1.0
anchor_right = 1.0
anchor_bottom = 1.0
offset_top = -420.0
grow_horizontal = 2
grow_vertical = 0
mouse_filter = 2
color = Color(0.557, 0.792, 0.902, 0.45)

[node name="Margin" type="MarginContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/margin_left = 40
theme_override_constants/margin_top = 120
theme_override_constants/margin_right = 40
theme_override_constants/margin_bottom = 80

[node name="VBox" type="VBoxContainer" parent="Margin"]
layout_mode = 2
theme_override_constants/separation = 24

[node name="Title" type="Label" parent="Margin/VBox"]
layout_mode = 2
theme_type_variation = &"TitleLabel"
theme_override_colors/font_color = Color(0.878, 0.482, 0, 1)
theme_override_font_sizes/font_size = 72
text = "Reading Racoon"
horizontal_alignment = 1

[node name="Subtitle" type="Label" parent="Margin/VBox"]
layout_mode = 2
theme_type_variation = &"MutedLabel"
theme_override_font_sizes/font_size = 30
text = "Read, play and grow!"
horizontal_alignment = 1

[node name="Spacer" type="Control" parent="Margin/VBox"]
layout_mode = 2
size_flags_vertical = 3

[node name="Bubble" type="PanelContainer" parent="Margin/VBox"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 4
script = ExtResource("4_bubble")

[node name="RaccoonRow" type="CenterContainer" parent="Margin/VBox"]
layout_mode = 2

[node name="Raccoon" type="Control" parent="Margin/VBox/RaccoonRow"]
unique_name_in_owner = true
custom_minimum_size = Vector2(340, 340)
layout_mode = 2
script = ExtResource("3_raccoon")

[node name="Spacer2" type="Control" parent="Margin/VBox"]
layout_mode = 2
size_flags_vertical = 3

[node name="PlayButton" type="Button" parent="Margin/VBox"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 120)
layout_mode = 2
theme_override_font_sizes/font_size = 40
text = "LET'S READ!"
script = ExtResource("2_chunky")
