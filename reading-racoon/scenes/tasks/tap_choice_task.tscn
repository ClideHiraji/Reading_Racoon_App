[gd_scene format=3]

[ext_resource type="Script" path="res://scenes/tasks/tap_choice_task.gd" id="1_tap"]

[node name="TapChoiceTask" type="VBoxContainer"]
size_flags_vertical = 3
theme_override_constants/separation = 20
alignment = 1
script = ExtResource("1_tap")

[node name="Picture" type="Label" parent="."]
unique_name_in_owner = true
layout_mode = 2
theme_override_font_sizes/font_size = 120
text = "🐱"
horizontal_alignment = 1

[node name="Word" type="Label" parent="."]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"ReadWord"
text = "cat"
horizontal_alignment = 1

[node name="Choices" type="GridContainer" parent="."]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 4
theme_override_constants/h_separation = 24
theme_override_constants/v_separation = 24
columns = 3
